{
  "name": "business-management-system-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm --workspace=backend run db:deploy && npm --workspace=backend run start",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=backend run dev",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "build:backend": "npm --workspace=backend run build",
    "build:frontend": "npm --workspace=frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "prisma:generate": "npm --workspace=backend run prisma:generate",
    "prisma:migrate": "npm --workspace=backend run prisma:migrate"
  }
}
