{
  "name": "business-management-api",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "db:deploy": "prisma db push --skip-generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "bcryptjs": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "^5.0.0",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "morgan": "latest",
    "winston": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "latest",
    "@types/node": "latest",
    "prisma": "^6.8.2",
    "tsx": "latest",
    "typescript": "latest"
  }
}
